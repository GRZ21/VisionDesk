  <property name="styleSheet">
   <string>QWidget#ResultVisualization { background: #ffffff; color: #334155; font: 13px &quot;Microsoft YaHei&quot;; }
QWidget#ResultVisualization QLabel { color: #334155; background: transparent; border: none; }
QWidget#ResultVisualization QPushButton { background: #ffffff; color: #334155; border: 1px solid #cfdbea; border-radius: 5px; padding: 5px 10px; }
QWidget#ResultVisualization QPushButton:hover { background: #edf5ff; border-color: #7aade4; }
QWidget#ResultVisualization QPushButton:pressed { background: #deedff; }
QWidget#ResultVisualization QPushButton#startInferenceButton { background: #347ed3; color: white; border-color: #347ed3; font-weight: 600; }
QWidget#ResultVisualization QPushButton#clearResultsButton { color: #c84444; }
QWidget#ResultVisualization QLineEdit, QWidget#ResultVisualization QComboBox, QWidget#ResultVisualization QDoubleSpinBox { min-height: 28px; border: 1px solid #d5dfeb; border-radius: 4px; background: #f8fafc; padding: 2px 6px; }
QWidget#ResultVisualization QLineEdit#modelPathEdit { background: #f1f4f7; color: #64748b; }
QWidget#ResultVisualization QListWidget, QWidget#ResultVisualization QTableWidget { background: white; border: 1px solid #dbe4ef; border-radius: 3px; selection-background-color: #e7f1ff; selection-color: #245f9c; outline: none; }
QWidget#ResultVisualization QListWidget::item { padding: 6px; border-bottom: 1px solid #e8edf4; }
QWidget#ResultVisualization QListWidget::item:selected { background: #eaf3ff; border: 1px solid #7fb2ed; }
QWidget#ResultVisualization QHeaderView::section { background: #f3f6fa; color: #475569; border: none; border-right: 1px solid #e0e7ef; border-bottom: 1px solid #dbe4ef; padding: 7px 4px; font-weight: 600; }
QWidget#ResultVisualization QSlider::groove:horizontal { height: 4px; background: #e8edf4; border-radius: 2px; }
QWidget#ResultVisualization QSlider::sub-page:horizontal { background: #347ed3; border-radius: 2px; }
QWidget#ResultVisualization QSlider::handle:horizontal { background: white; border: 1px solid #94a3b8; width: 16px; height: 16px; margin: -6px 0; border-radius: 9px; }
QWidget#ResultVisualization QSlider::handle:horizontal { min-height: 16px; }
QWidget#ResultVisualization QComboBox::drop-down { width: 20px; border: none; }
QWidget#ResultVisualization QDoubleSpinBox::up-button, QWidget#ResultVisualization QDoubleSpinBox::down-button { width: 16px; }
</string>
